# Postgres (Neon in production). Pooled URL for the app, unpooled for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel Blob (photo uploads). Without it, uploads are written to public/uploads in dev.
BLOB_READ_WRITE_TOKEN=

# Extra Better Auth origins, comma-separated (wildcards allowed)
TRUSTED_ORIGINS=

# Email (Resend via the Vercel Marketplace). Without a key, emails print to the dev server log.
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
# Optional override, e.g. "Boro <hello@example.com>"
EMAIL_FROM=
